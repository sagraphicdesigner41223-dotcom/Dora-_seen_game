        function completeCurrentStep() {
            gameState.isLocked = true;
            gameState.stars += 1;
            saveState();
            updateProgressHUD();

            SoundEngine.playSuccess();
            triggerCelebrationVisuals();

            document.getElementById('lvl-dora').classList.add('anim-joy');
            document.getElementById('lvl-boots').classList.add('anim-joy');

            const praise = getRandomPraise();
            SoundEngine.speak(praise, false);

            const isLastStep = gameState.currentStepIndex >= currentSteps.length - 1;
            const fb = document.getElementById('feedback-banner');
            const fbText = document.getElementById('feedback-text');
            const fbBtn = document.getElementById('feedback-action-btn');

            fb.className = 'rounded-3xl p-4 border-4 shadow-xl text-center bg-emerald-100 border-emerald-500';
