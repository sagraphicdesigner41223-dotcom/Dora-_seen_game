                }
                if ('speechSynthesis' in window) {
                    const loadVoices = () => {
                        const voices = window.speechSynthesis.getVoices();
                        this.arabicVoice = voices.find(v => v.lang.includes('ar-SA') || v.lang.includes('ar-EG') || v.lang.startsWith('ar')) || null;
                    };
                    loadVoices();
                    window.speechSynthesis.onvoiceschanged = loadVoices;
                }
