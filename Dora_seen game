        }

        function toggleMute() {
            SoundEngine.muted = !SoundEngine.muted;
            const btn = document.getElementById('btn-mute');
            btn.textContent = SoundEngine.muted ? '🔇' : '🔊';
            if (SoundEngine.muted && 'speechSynthesis' in window) {
                window.speechSynthesis.cancel();
            }
        }

        function resetProgressConfirm() {
            SoundEngine.playClick();
            const modal = document.getElementById('custom-modal');
            modal.classList.remove('hidden');
            document.getElementById('modal-confirm-btn').onclick = () => {
                closeModal();
                localStorage.removeItem(STORAGE_KEY);
                gameState.childName = '';
                gameState.unlockedLevel = 1;
                gameState.completedLevels = [];
                gameState.stars = 0;
                document.getElementById('child-name-input').value = '';
                document.getElementById('btn-continue-saved').classList.add('hidden');
                showScreen('screen-welcome');
            };
        }

        function closeModal() {
            document.getElementById('custom-modal').classList.add('hidden');
        }

        window.onload = function () {
            ['welcome-dora', 'map-dora', 'lvl-dora', 'cert-dora', 'song-dora'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.innerHTML = DORA_SVG;
            });
            ['welcome-boots', 'map-boots', 'lvl-boots', 'cert-boots', 'song-boots'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.innerHTML = BOOTS_SVG;
            });

            if (loadState()) {
                document.getElementById('child-name-input').value = gameState.childName;
                const contBtn = document.getElementById('btn-continue-saved');
                contBtn.textContent = `متابعة مغامرة ${gameState.childName} (${gameState.stars} ⭐)`;
                contBtn.classList.remove('hidden');
            }

            SoundEngine.init();
        };
    </script>
</body>
</html>
