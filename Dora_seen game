            const certSpeech = `هيّا نحتفل! هيّا نحتفل! ألف مبروك يا ${gameState.childName}! أتممت مغامرة حرف السين، وأصبحت اليوم بطل حرف السين! تصفيق كبير لـ ${gameState.childName}!`;
            setTimeout(() => {
