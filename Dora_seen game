            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }
        body {
            font-family: var(--font-main);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            background: #87CEEB;
            min-height: 100vh;
            touch-action: manipulation;
        }

        /* حركات كرتونية ناعمة */
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }
        @keyframes bounceJoy {
            0%, 100% { transform: translateY(0) scale(1); }
            30% { transform: translateY(-22px) scale(1.06); }
            60% { transform: translateY(-8px) scale(0.98); }
        }
        @keyframes shakeGentle {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-8px) rotate(-2deg); }
            40% { transform: translateX(8px) rotate(2deg); }
            60% { transform: translateX(-6px); }
            80% { transform: translateX(6px); }
        }
        @keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 0 0 rgba(250, 204, 21, 0.7); transform: scale(1); }
            50% { box-shadow: 0 0 0 16px rgba(250, 204, 21, 0); transform: scale(1.05); }
