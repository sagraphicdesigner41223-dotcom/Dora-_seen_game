            fbText.textContent = `${praise} (+1 ⭐)`;

            fbBtn.className = 'btn-kid bg-emerald-500 hover:bg-emerald-600 text-white font-black text-xl px-8 py-3 rounded-2xl border-2 border-emerald-700';
            fbBtn.textContent = isLastStep ? 'إنهاء المحطة والحصول على المكافأة 🏆' : 'السؤال التالي ⬅️';
            fbBtn.onclick = () => advanceStep();

            fb.classList.remove('hidden');
        }

        function advanceStep() {
            SoundEngine.playClick();
            if (gameState.currentStepIndex < currentSteps.length - 1) {
                gameState.currentStepIndex++;
                renderCurrentStep();
            } else {
                finishCurrentLevel();
            }
        }

        function finishCurrentLevel() {
            const lvlId = gameState.currentLevelId;
            if (!gameState.completedLevels.includes(lvlId)) {
                gameState.completedLevels.push(lvlId);
                gameState.stars += 2;
            }
            if (lvlId < 6 && gameState.unlockedLevel <= lvlId) {
                gameState.unlockedLevel = lvlId + 1;
            }
            saveState();

            if (lvlId === 6) {
                showFinalCertificate();
            } else {
                showLevelCelebrationSong(lvlId);
            }
        }

        let currentLevelSongLyrics = '';

        function getLevelSongData(lvlId) {
            const name = gameState.childName || 'يا بطل';
            const songs = {
                1: `هيّا نغنّي يا ${name}، لا لا لا! عرفنا حرف السين، سْ سْ سْ، له ثلاث أسنان وبلا نقاط، شاطر يا ${name}!`,
                2: `سَ سِ سُ، غنّي مع دورا وبوتس يا ${name}! فتحة سَ، كسرة سِ، ضمة سُ، يا سلام على صوتك الجميل!`,
                3: `سمكة وسيارة وساعة، هيّا نصفّق لـ ${name}! بطل الكلمات وحرف السين، هيّا هيّا يا شاطر!`,
                4: `في الأول سـ، في الوسط ـسـ، في الآخر ـس! أحسنت يا ${name} يا بطل الحروف، هيّا نكمل المغامرة!`,
                5: `بحثنا في الغابة وجمعنا الكنوز! برافو يا ${name} وبرافو يا بوتس، بقي تحدّي البطل الكبير!`
            };
            return songs[lvlId] || `أحسنت يا ${name}! هيّا نحتفل بنجاحك الكبير!`;
        }

        function showLevelCelebrationSong(lvlId) {
            const modal = document.getElementById('level-song-modal');
            document.getElementById('song-modal-title').textContent = `أغنية نجاح المحطة ${lvlId}! 🎶`;
            currentLevelSongLyrics = getLevelSongData(lvlId);
            document.getElementById('song-lyrics-text').textContent = currentLevelSongLyrics;

            modal.classList.remove('hidden');
            triggerCelebrationVisuals();
            SoundEngine.playLevelSongMelody();
            setTimeout(() => {
                SoundEngine.speak(currentLevelSongLyrics, false);
            }, 900);

            document.getElementById('btn-continue-after-song').onclick = () => {
                SoundEngine.playClick();
                if ('speechSynthesis' in window) window.speechSynthesis.cancel();
                modal.classList.add('hidden');
                goToMap();
                const msg = `مبارك يا ${gameState.childName}! لقد أنهيت المحطة رقم ${lvlId} وفتحت المحطة التالية!`;
                document.getElementById('map-welcome-speech').textContent = msg;
            };
        }

        function replayLevelSong() {
            triggerCelebrationVisuals();
            SoundEngine.playLevelSongMelody();
            setTimeout(() => {
                SoundEngine.speak(currentLevelSongLyrics, false);
            }, 900);
        }

