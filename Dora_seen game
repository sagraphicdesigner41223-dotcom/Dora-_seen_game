            0% { transform: translateY(110vh) rotate(0deg); opacity: 1; }
            100% { transform: translateY(-25vh) rotate(15deg); opacity: 0.9; }
        }
        @keyframes confettiFall {
            0% { transform: translateY(-10vh) rotate(0deg); opacity: 1; }
            100% { transform: translateY(110vh) rotate(720deg); opacity: 0; }
        }
        @keyframes butterflyFly {
            0% { transform: translate(0, 0) rotate(5deg); }
            25% { transform: translate(25px, -18px) rotate(-5deg); }
            50% { transform: translate(50px, 5px) rotate(8deg); }
            75% { transform: translate(20px, 15px) rotate(-4deg); }
            100% { transform: translate(0, 0) rotate(5deg); }
        }
        @keyframes waveHand {
            0%, 100% { transform: rotate(0deg); }
            25% { transform: rotate(18deg); }
            75% { transform: rotate(-12deg); }
        }
        @keyframes speakingWave {
            0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(236, 72, 153, 0.7); }
            50% { transform: scale(1.04); box-shadow: 0 0 0 14px rgba(236, 72, 153, 0); }
        }

        .anim-float { animation: float 3s ease-in-out infinite; }
        .anim-joy { animation: bounceJoy 0.8s ease-in-out infinite; }
        .anim-shake { animation: shakeGentle 0.5s ease-in-out; }
        .anim-hint { animation: pulseGlow 1.3s infinite; border-color: #facc15 !important; background-color: #fef9c3 !important; }
        .anim-butterfly { animation: butterflyFly 6s ease-in-out infinite; }
        .anim-wave { transform-origin: 70% 80%; animation: waveHand 1.6s ease-in-out infinite; }
        .is-speaking { animation: speakingWave 1s infinite; border-color: #ec4899 !important; }

