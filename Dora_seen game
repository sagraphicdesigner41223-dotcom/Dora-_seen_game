                    if (this.arabicVoice) utter.voice = this.arabicVoice;
                    utter.rate = 0.86;
                    utter.pitch = 1.18;

                    utter.onstart = () => setVisualSpeaking(true);
                    utter.onend = () => setVisualSpeaking(false);
                    utter.onerror = () => setVisualSpeaking(false);

                    window.speechSynthesis.speak(utter);
                } catch (e) {
                    setVisualSpeaking(false);
