        function shuffle(arr) {
            const copy = [...arr];
            for (let i = copy.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [copy[i], copy[j]] = [copy[j], copy[i]];
            }
            return copy;
        }

        function triggerCelebrationVisuals() {
            const layer = document.getElementById('celebration-layer');
            layer.innerHTML = '';
            const balloonColors = ['#ef4444', '#3b82f6', '#eab308', '#ec4899', '#10b981', '#8b5cf6'];
            const confettiEmojis = ['⭐', '✨', '🌟', '🎉', '🎊'];

            for (let i = 0; i < 12; i++) {
                const b = document.createElement('div');
                const color = balloonColors[i % balloonColors.length];
                const left = Math.random() * 90 + 2;
                const delay = Math.random() * 0.6;
                b.style.cssText = `
                    position: absolute;
                    left: ${left}%;
                    bottom: -80px;
                    width: 44px;
                    height: 54px;
                    background: ${color};
                    border-radius: 50% 50% 50% 50% / 45% 45% 55% 55%;
                    box-shadow: inset -6px -6px 12px rgba(0,0,0,0.18);
                    animation: balloonRise 2.6s ease-out ${delay}s forwards;
                `;
                const string = document.createElement('div');
                string.style.cssText = 'width: 2px; height: 35px; background: rgba(0,0,0,0.3); margin: 54px auto 0;';
                b.appendChild(string);
                layer.appendChild(b);
            }

            for (let i = 0; i < 18; i++) {
                const c = document.createElement('div');
                c.textContent = confettiEmojis[i % confettiEmojis.length];
                const left = Math.random() * 94 + 2;
                const delay = Math.random() * 0.5;
                c.style.cssText = `
                    position: absolute;
                    left: ${left}%;
                    top: -40px;
                    font-size: ${22 + Math.random() * 16}px;
                    animation: confettiFall 2.4s linear ${delay}s forwards;
                `;
                layer.appendChild(c);
            }

            setTimeout(() => { layer.innerHTML = ''; }, 3200);
        }

        function getRandomPraise() {
            const name = gameState.childName || 'يا بطل';
            const phrases = [
                `أحسنت يا ${name}! 🌟`,
                `رائع يا بطل! 👏`,
                `إجابة صحيحة! 🎉`,
                `ممتاز يا ${name}! ⭐`,
                `أنت ذكي جدًا يا ${name}! 🏆`
            ];
            return phrases[Math.floor(Math.random() * phrases.length)];
        }

        let currentSteps = [];

        function showScreen(screenId) {
            ['screen-welcome', 'screen-map', 'screen-level', 'screen-certificate'].forEach(id => {
                document.getElementById(id).classList.add('hidden');
            });
            document.getElementById(screenId).classList.remove('hidden');

            const hud = document.getElementById('top-hud');
            const progressWrap = document.getElementById('hud-progress-wrap');
            if (screenId === 'screen-welcome' || screenId === 'screen-certificate') {
                hud.classList.add('hidden');
            } else {
                hud.classList.remove('hidden');
                document.getElementById('hud-child-name').textContent = gameState.childName;
                document.getElementById('hud-stars').textContent = gameState.stars;
                if (screenId === 'screen-level') {
                    progressWrap.classList.remove('hidden');
                } else {
                    progressWrap.classList.add('hidden');
                }
            }
        }

        function startAdventure(useSaved) {
            SoundEngine.init();
            SoundEngine.playClick();

            if (!useSaved) {
                const input = document.getElementById('child-name-input');
                const val = input.value.trim();
                const err = document.getElementById('name-error-msg');
                if (!val) {
                    err.classList.remove('hidden');
                    input.classList.add('anim-shake', 'border-rose-500');
                    setTimeout(() => input.classList.remove('anim-shake'), 500);
                    SoundEngine.speak('من فضلك اكتب اسمك يا بطل لنبدأ المغامرة!', false);
                    return;
                }
                err.classList.add('hidden');
                if (gameState.childName !== val) {
                    gameState.childName = val;
                    gameState.unlockedLevel = 1;
                    gameState.completedLevels = [];
                    gameState.stars = 0;
                    saveState();
                }
            }

            goToMap(true);
        }

        function goToMap(isFirstGreeting = false) {
            gameState.isLocked = false;
            showScreen('screen-map');
            renderMap();

            const greetingText = `مرحبًا يا ${gameState.childName}! أنا دورا، وهذا صديقي بوتس. هل أنت مستعد لمغامرتنا مع حرف السين؟ هيا بنا!`;
            document.getElementById('map-welcome-speech').textContent = greetingText;

            if (isFirstGreeting) {
                SoundEngine.speak(greetingText);
            } else {
                SoundEngine.speak(`اختر المحطة التالية يا ${gameState.childName}!`);
            }
        }

        function speakMapGreeting() {
            SoundEngine.playClick();
            const txt = `مرحبًا يا ${gameState.childName}! أنا دورا، وهذا صديقي بوتس. اضغط على المحطة المفتوحة لنكتشف حرف السين!`;
            SoundEngine.speak(txt);
        }

        function renderMap() {
            const grid = document.getElementById('levels-grid');
            grid.innerHTML = '';

            LEVELS_META.forEach(lvl => {
                const isUnlocked = lvl.id <= gameState.unlockedLevel;
                const isCompleted = gameState.completedLevels.includes(lvl.id);

                const card = document.createElement('button');
                card.disabled = !isUnlocked;
                card.onclick = () => startLevel(lvl.id);

                let statusBadge = '';
                let cardStyle = '';
                if (isCompleted) {
                    statusBadge = `<span class="bg-emerald-500 text-white text-xs font-black px-3 py-1 rounded-full">مكتمل ⭐⭐</span>`;
                    cardStyle = 'bg-white border-emerald-500 hover:scale-[1.03]';
                } else if (isUnlocked) {
                    statusBadge = `<span class="bg-amber-400 text-amber-950 text-xs font-black px-3 py-1 rounded-full animate-pulse">مفتوح الآن! 🚀</span>`;
                    cardStyle = 'bg-white border-amber-400 ring-4 ring-amber-300/60 hover:scale-[1.03]';
                } else {
                    statusBadge = `<span class="bg-slate-300 text-slate-700 text-xs font-black px-3 py-1 rounded-full">مقفل 🔒</span>`;
                    cardStyle = 'bg-slate-100/80 border-slate-300 opacity-75';
                }

                card.className = `btn-kid rounded-3xl p-5 border-4 text-right flex flex-col justify-between transition-transform ${cardStyle}`;
                card.innerHTML = `
                    <div class="flex items-center justify-between w-full mb-3">
                        <span class="w-14 h-14 rounded-2xl bg-sky-100 border-2 border-sky-300 flex items-center justify-center text-3xl shadow-inner">
                            ${isUnlocked ? lvl.icon : '🔒'}
                        </span>
                        ${statusBadge}
                    </div>
                    <div>
                        <p class="text-xs font-extrabold text-purple-600 mb-0.5">المحطة ${lvl.id} • ${lvl.area}</p>
                        <h3 class="text-xl font-black text-slate-800">${lvl.title}</h3>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function startLevel(levelId) {
            SoundEngine.playClick();
            gameState.currentLevelId = levelId;
            gameState.currentStepIndex = 0;
            gameState.isLocked = false;
            gameState.wrongAttempts = 0;

            currentSteps = getLevelSteps(levelId);
            const meta = LEVELS_META.find(m => m.id === levelId);

            const levelScreen = document.getElementById('screen-level');
            levelScreen.className = `flex-1 p-3 sm:p-6 flex flex-col ${meta.bgClass}`;
            document.getElementById('lvl-badge').textContent = `المحطة ${levelId}: ${meta.area}`;

            showScreen('screen-level');
            renderCurrentStep();
        }

        function updateProgressHUD() {
            const total = currentSteps.length;
            const current = gameState.currentStepIndex + 1;
            const pct = Math.round(((gameState.currentStepIndex) / total) * 100);
            document.getElementById('hud-step-text').textContent = `النشاط ${current} من ${total}`;
            document.getElementById('hud-progress-bar').style.width = `${pct}%`;
            document.getElementById('hud-stars').textContent = gameState.stars;
        }

        function resetCharactersMood() {
            document.getElementById('lvl-dora').classList.remove('anim-joy');
            document.getElementById('lvl-boots').classList.remove('anim-joy');
        }

        function hideFeedback() {
            const fb = document.getElementById('feedback-banner');
            fb.classList.add('hidden');
        }

        function repeatCurrentAudio() {
            SoundEngine.playClick();
            if (SoundEngine.lastSpokenText) {
                SoundEngine.speak(SoundEngine.lastSpokenText, false);
            }
        }

        function triggerHint() {
            SoundEngine.playClick();
            const step = currentSteps[gameState.currentStepIndex];
            if (!step) return;

            if (step.targetSoundText) {
                SoundEngine.speak(`تلميح من دورا: استمع جيداً... ${step.targetSoundText}`, false);
            } else {
                SoundEngine.speak(step.speech, false);
            }

            const correctEls = document.querySelectorAll('[data-correct="true"]');
            correctEls.forEach(el => {
                el.classList.add('anim-hint');
            });
        }

        function renderCurrentStep() {
            gameState.isLocked = false;
            gameState.wrongAttempts = 0;
            resetCharactersMood();
            hideFeedback();
            updateProgressHUD();

            const step = currentSteps[gameState.currentStepIndex];
            document.getElementById('lvl-instruction-title').textContent = step.title;
            document.getElementById('lvl-instruction-sub').textContent = step.sub;

            const stage = document.getElementById('level-stage');
            stage.innerHTML = '';

            SoundEngine.speak(step.speech, true);

            switch (step.type) {
                case 'explain_letter': renderExplainLetter(stage, step); break;
                case 'mcq_cards': renderMcqCards(stage, step); break;
                case 'multi_select_cards': renderMultiSelectCards(stage, step); break;
                case 'audio_mcq': renderAudioMcq(stage, step); break;
                case 'explain_harakat': renderExplainHarakat(stage, step); break;
                case 'vocab_showcase': renderVocabShowcase(stage, step); break;
                case 'image_mcq': renderImageMcq(stage, step); break;
                case 'multi_image_select': renderMultiImageSelect(stage, step); break;
                case 'explain_positions': renderExplainPositions(stage, step); break;
                case 'position_mcq': renderPositionMcq(stage, step); break;
                case 'word_position_mcq': renderWordPositionMcq(stage, step); break;
                case 'forest_hunt': renderForestHunt(stage, step); break;
            }
        }

